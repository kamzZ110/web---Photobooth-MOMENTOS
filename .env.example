# ==============================================================================
# MOMENTOS PHOTOBOOTH — PRODUCTION ENVIRONMENT VARIABLES EXAMPLE
# Salin file ini menjadi `.env` di root atau di dalam `apps/web/.env`
# ==============================================================================

# 1. Frontend WebSocket Signaling Server URL (@momentos/web)
VITE_WS_URL=ws://localhost:4000/ws

# 2. WebRTC STUN & Optional TURN Relay Configuration (Tahap 5 & 7)
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# 3. Backend Realtime Server (@momentos/server)
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
